{
  "$defs": {
    "CompanyResult": {
      "additionalProperties": false,
      "properties": {
        "input_domain": {
          "title": "Input Domain",
          "type": "string"
        },
        "normalized_domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Domain"
        },
        "status": {
          "default": "failed",
          "enum": [
            "success",
            "partial",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "company_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Company Name"
        },
        "company_overview": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Company Overview"
        },
        "target_audience": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Audience"
        },
        "contact_points": {
          "items": {
            "$ref": "#/$defs/Contact"
          },
          "title": "Contact Points",
          "type": "array"
        },
        "team_members": {
          "items": {
            "$ref": "#/$defs/Person"
          },
          "title": "Team Members",
          "type": "array"
        },
        "confidence_score": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence Score",
          "type": "number"
        },
        "confidence_breakdown": {
          "$ref": "#/$defs/Confidence"
        },
        "field_evidence": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/Evidence"
            },
            "type": "array"
          },
          "title": "Field Evidence",
          "type": "object"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "title": "Sources",
          "type": "array"
        },
        "crawl": {
          "$ref": "#/$defs/CrawlStats"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "search_requests": {
          "default": 0,
          "minimum": 0,
          "title": "Search Requests",
          "type": "integer"
        },
        "estimated_search_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Search Cost Usd"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/Error"
          },
          "title": "Errors",
          "type": "array"
        }
      },
      "required": [
        "input_domain"
      ],
      "title": "CompanyResult",
      "type": "object"
    },
    "Confidence": {
      "additionalProperties": false,
      "properties": {
        "overview_supported": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Overview Supported",
          "type": "number"
        },
        "audience_supported": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Audience Supported",
          "type": "number"
        },
        "public_contact_present": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Public Contact Present",
          "type": "number"
        },
        "named_leader_with_supported_role_present": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Named Leader With Supported Role Present",
          "type": "number"
        },
        "directly_supported_linkedin_fraction": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Directly Supported Linkedin Fraction",
          "type": "number"
        },
        "retrieval_success_fraction": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Retrieval Success Fraction",
          "type": "number"
        },
        "explanation": {
          "default": "Evidence/completeness heuristic; not a calibrated probability of correctness",
          "title": "Explanation",
          "type": "string"
        }
      },
      "title": "Confidence",
      "type": "object"
    },
    "Contact": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "title": "Email",
          "type": "string"
        },
        "category": {
          "default": "other_business",
          "enum": [
            "general",
            "sales",
            "support",
            "press",
            "other_business"
          ],
          "title": "Category",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "verification_status": {
          "const": "publicly_observed_not_deliverability_verified",
          "default": "publicly_observed_not_deliverability_verified",
          "title": "Verification Status",
          "type": "string"
        }
      },
      "required": [
        "email",
        "evidence"
      ],
      "title": "Contact",
      "type": "object"
    },
    "CrawlStats": {
      "additionalProperties": false,
      "properties": {
        "attempted_pages": {
          "default": 0,
          "minimum": 0,
          "title": "Attempted Pages",
          "type": "integer"
        },
        "usable_pages": {
          "default": 0,
          "minimum": 0,
          "title": "Usable Pages",
          "type": "integer"
        },
        "duplicate_pages": {
          "default": 0,
          "minimum": 0,
          "title": "Duplicate Pages",
          "type": "integer"
        },
        "html_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Html Bytes",
          "type": "integer"
        },
        "cleaned_text_chars": {
          "default": 0,
          "minimum": 0,
          "title": "Cleaned Text Chars",
          "type": "integer"
        },
        "estimated_context_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Estimated Context Tokens",
          "type": "integer"
        },
        "estimated_request_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Estimated Request Tokens",
          "type": "integer"
        },
        "dropped_chunks": {
          "default": 0,
          "minimum": 0,
          "title": "Dropped Chunks",
          "type": "integer"
        },
        "duration_seconds": {
          "default": 0,
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        }
      },
      "title": "CrawlStats",
      "type": "object"
    },
    "Error": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "material": {
          "default": true,
          "title": "Material",
          "type": "boolean"
        }
      },
      "required": [
        "stage",
        "code",
        "message"
      ],
      "title": "Error",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "excerpt": {
          "title": "Excerpt",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "excerpt",
        "source_url"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "nearby_text": {
          "default": "",
          "title": "Nearby Text",
          "type": "string"
        }
      },
      "required": [
        "url",
        "text"
      ],
      "title": "Link",
      "type": "object"
    },
    "Person": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "linkedin_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Linkedin Url"
        },
        "linkedin_status": {
          "default": "not_found",
          "enum": [
            "first_party_link",
            "search_candidate",
            "not_found"
          ],
          "title": "Linkedin Status",
          "type": "string"
        },
        "relationship_evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Relationship Evidence",
          "type": "array"
        },
        "role_evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Role Evidence",
          "type": "array"
        },
        "profile_evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Profile Evidence",
          "type": "array"
        },
        "linkedin_candidates": {
          "items": {
            "$ref": "#/$defs/ProfileCandidate"
          },
          "title": "Linkedin Candidates",
          "type": "array"
        }
      },
      "required": [
        "name",
        "relationship_evidence"
      ],
      "title": "Person",
      "type": "object"
    },
    "ProfileCandidate": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "status": {
          "const": "search_candidate",
          "default": "search_candidate",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "url",
        "evidence"
      ],
      "title": "ProfileCandidate",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "requested_url": {
          "title": "Requested Url",
          "type": "string"
        },
        "final_url": {
          "title": "Final Url",
          "type": "string"
        },
        "kind": {
          "default": "first_party_html",
          "enum": [
            "first_party_html",
            "search_snippet"
          ],
          "title": "Kind",
          "type": "string"
        },
        "retrieval_method": {
          "enum": [
            "playwright",
            "http_fallback",
            "tavily",
            "fixture"
          ],
          "title": "Retrieval Method",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "http_status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        },
        "usable": {
          "default": false,
          "title": "Usable",
          "type": "boolean"
        },
        "selection_reason": {
          "default": "",
          "title": "Selection Reason",
          "type": "string"
        },
        "depth": {
          "default": 0,
          "title": "Depth",
          "type": "integer"
        },
        "html_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Html Bytes",
          "type": "integer"
        },
        "cleaned_text_chars": {
          "default": 0,
          "minimum": 0,
          "title": "Cleaned Text Chars",
          "type": "integer"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/Link"
          },
          "title": "Links",
          "type": "array"
        },
        "email_candidates": {
          "items": {
            "type": "string"
          },
          "title": "Email Candidates",
          "type": "array"
        },
        "search_query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search Query"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "requested_url",
        "final_url",
        "retrieval_method"
      ],
      "title": "Source",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "cached_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cached Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "request_count": {
          "default": 0,
          "minimum": 0,
          "title": "Request Count",
          "type": "integer"
        },
        "reported_response_count": {
          "default": 0,
          "minimum": 0,
          "title": "Reported Response Count",
          "type": "integer"
        },
        "response_ids": {
          "items": {
            "type": "string"
          },
          "title": "Response Ids",
          "type": "array"
        },
        "request_ids": {
          "items": {
            "type": "string"
          },
          "title": "Request Ids",
          "type": "array"
        },
        "models": {
          "items": {
            "type": "string"
          },
          "title": "Models",
          "type": "array"
        },
        "accounting_complete": {
          "default": true,
          "title": "Accounting Complete",
          "type": "boolean"
        },
        "estimated_llm_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Llm Cost Usd"
        },
        "cost_reason": {
          "default": "Pricing not configured",
          "title": "Cost Reason",
          "type": "string"
        },
        "cost_scope": {
          "default": "Reported LLM usage only; excludes browser, network, and search costs",
          "title": "Cost Scope",
          "type": "string"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "mode": {
      "enum": [
        "live",
        "demo"
      ],
      "title": "Mode",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "configuration": {
      "additionalProperties": true,
      "title": "Configuration",
      "type": "object"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/CompanyResult"
      },
      "title": "Results",
      "type": "array"
    },
    "complete": {
      "default": false,
      "title": "Complete",
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "mode",
    "model",
    "configuration"
  ],
  "title": "RunOutput",
  "type": "object"
}
