OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TAVILY_API_KEY=
ENABLE_SEARCH=false
MAX_PAGES_PER_DOMAIN=8
MAX_DEPTH=2
DOMAIN_CONCURRENCY=2
NAVIGATION_TIMEOUT_MS=30000
RENDER_WAIT_MS=5000
HTTP_TIMEOUT_SECONDS=15
LLM_TIMEOUT_SECONDS=45
DOMAIN_BUDGET_SECONDS=180
MAX_CONTEXT_TOKENS=8000
MAX_OUTPUT_TOKENS=3500
MAX_LLM_REQUESTS_PER_DOMAIN=4
# Optional standard USD rates verified on the official model page below.
# Update ALL pricing fields when changing models; blank rates produce null cost.
PRICING_MODEL=gpt-4.1-mini
INPUT_PRICE_PER_MILLION=0.40
CACHED_INPUT_PRICE_PER_MILLION=0.10
OUTPUT_PRICE_PER_MILLION=1.60
PRICING_SOURCE=https://developers.openai.com/api/docs/models/gpt-4.1-mini
PRICING_VERIFIED_AT=2026-09-11
