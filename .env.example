LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TAVILY_API_KEY=
ENABLE_SEARCH=false
MAX_PAGES_PER_DOMAIN=8
MAX_DEPTH=2
DOMAIN_CONCURRENCY=1
NAVIGATION_TIMEOUT_MS=30000
RENDER_WAIT_MS=5000
HTTP_TIMEOUT_SECONDS=15
LLM_TIMEOUT_SECONDS=45
DOMAIN_BUDGET_SECONDS=180
MAX_CONTEXT_TOKENS=8000
MAX_OUTPUT_TOKENS=3500
MAX_LLM_REQUESTS_PER_DOMAIN=4
MAX_HTML_BYTES=12000000
# Configured Gemini free-tier rates. Paid accounts/models need their own rates.
# Update ALL pricing fields when changing models; blank rates produce null cost.
PRICING_MODEL=gemini-3.5-flash-lite
INPUT_PRICE_PER_MILLION=0
CACHED_INPUT_PRICE_PER_MILLION=0
OUTPUT_PRICE_PER_MILLION=0
PRICING_SOURCE=https://ai.google.dev/gemini-api/docs/pricing#gemini-3.5-flash-lite
PRICING_VERIFIED_AT=2026-09-14
